{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/accounts/reset-password.js": {
      "maxDuration": 60,
      "includeFiles": ["functions/package.json", "functions/reset-handler.js"]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}

